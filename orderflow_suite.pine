//@version=6
// ============================================================================
//  ORDER FLOW SUITE  —  Footprint · Delta · CVD · Imbalance · Absorption
//  All-in-one order-flow engine for TradingView (Pine Script v6)
//
//  HONEST APPROXIMATION NOTICE:
//  TradingView provides no real bid/ask tape. This indicator reconstructs
//  order flow from a lower-timeframe (LTF) volume feed via
//  request.security_lower_tf(). Each intrabar is classified as aggressive
//  buying (ask) or selling (bid) by its close position in range. On true
//  bid/ask feeds (Sierra Chart / Numbers Bars) figures will differ — treat
//  this as a high-quality proxy, not the raw tape.
// ============================================================================
indicator("Order Flow Suite — Footprint / Delta / CVD / Imbalance",
     shorttitle      = "OF Suite",
     overlay         = false,
     max_boxes_count = 500,
     max_labels_count= 500,
     max_lines_count = 500,
     precision       = 2)

// ─────────────────────────────  INPUTS  ────────────────────────────────────
// ── Instrument preset (tunes footprint row size + profile bin size)
gPre   = "⓪ Instrument Preset"
preset = input.string("Gold (XAUUSD)", "Preset",
     options=["Gold (XAUUSD)", "Forex (5-digit)", "Index / Crypto", "Custom (auto)"], group=gPre,
     tooltip="Gold: $0.5 footprint rows, $1.0 profile bins (COMEX/CFD gold).\nForex: 2-pip rows, 5-pip bins.\nIndex/Crypto & Custom: auto sizing from ATR / prior-day range and the manual inputs below.")

// Preset price steps (0 → use auto sizing). Gold tuned for XAUUSD.
float presetRow = preset == "Gold (XAUUSD)" ? 0.5    : preset == "Forex (5-digit)" ? 0.0002 : 0.0
float presetBin = preset == "Gold (XAUUSD)" ? 1.0    : preset == "Forex (5-digit)" ? 0.0005 : 0.0

// ── LTF Engine
gEng   = "① LTF Order-Flow Engine"
autoLtf= input.bool(true,  "Auto lower timeframe", group=gEng, tooltip="Pick the intrabar resolution automatically from the chart timeframe.")
manLtf = input.timeframe("1", "Manual lower timeframe", group=gEng)
clsMode= input.string("Close position", "Volume classification",
     options=["Close position", "Close vs Open"], group=gEng,
     tooltip="Close position: split each intrabar's volume by where it closed in its range (smoother, standard).\nClose vs Open: full bar to buyers if up, sellers if down.")

// ── Footprint
gFp    = "② Footprint (Bid × Ask numbers)"
showFp = input.bool(true, "Show footprint numbers", group=gFp)
fpBars = input.int(8, "Render last N bars", minval=1, maxval=40, group=gFp, tooltip="Footprint numbers are heavy; only the most recent N bars are drawn.")
rowsTgt= input.int(11, "Target rows per bar", minval=4, maxval=40, group=gFp, tooltip="Auto row height = ATR / this. Keeps rows bounded on any instrument.")
fpSize = input.string("Tiny", "Text size", options=["Tiny","Small","Normal"], group=gFp)
fpHeat = input.bool(true, "Heatmap cell shading", group=gFp, tooltip="Shade each Bid/Ask cell by its volume relative to the busiest cell in the bar. Off = flat cells.")
fpHide0= input.bool(true, "Hide empty (0) cells", group=gFp)

// ── Imbalance
gImb   = "③ Diagonal Imbalance"
imbRatio = input.float(3.0, "Imbalance ratio (x:1)", minval=1.5, step=0.5, group=gImb, tooltip="Ask@P vs Bid@P-1 (diagonal). 3.0 = 300%.")
stackN   = input.int(3, "Stacked count → zone", minval=2, maxval=8, group=gImb)
showStack= input.bool(true, "Draw stacked-imbalance zones", group=gImb)
zoneExt  = input.int(30, "Zone extend (bars)", minval=1, group=gImb)

// ── CVD / Delta
gCvd   = "④ Delta & CVD"
cvdAnchor = input.string("Session", "CVD anchor", options=["Session","Day","Week","None"], group=gCvd)
cvdSmooth = input.int(9, "CVD signal MA", minval=1, group=gCvd)
colorBars = input.bool(true, "Color candles by delta", group=gCvd)

// ── Patterns
gPat   = "⑤ Order-Flow Patterns"
showAbs = input.bool(true, "Absorption", group=gPat)
showExh = input.bool(true, "Exhaustion", group=gPat)
showTrap= input.bool(true, "Trapped traders", group=gPat)
showDiv = input.bool(true, "CVD / price divergence", group=gPat)
volFact = input.float(1.6, "High-volume factor (× avg)", minval=1.0, step=0.1, group=gPat)
exhFact = input.float(0.6, "Exhaustion volume factor (× avg)", minval=0.1, step=0.1, group=gPat)
dPct    = input.float(0.35, "Min |delta|/volume for pattern", minval=0.05, maxval=1.0, step=0.05, group=gPat)
divLb   = input.int(5, "Divergence pivot lookback", minval=2, group=gPat)

// ── Visuals
gVis   = "⑥ Visuals & Table"
showTbl = input.bool(true, "Show info table", group=gVis)
buyCol  = input.color(color.new(#26a69a, 0), "Buy / bullish", group=gVis)
sellCol = input.color(color.new(#ef5350, 0), "Sell / bearish", group=gVis)
neutCol = input.color(color.new(#787b86, 30), "Neutral", group=gVis)
pocCol  = input.color(color.new(#ffca28, 0), "POC / highlight", group=gVis)

// ── Volume Profile & Key Levels
gVP    = "⑦ Volume Profile & Key Levels"
showVP  = input.bool(true, "Developing volume profile", group=gVP)
profRows= input.int(24, "Profile rows (bins)", minval=8, maxval=60, group=gVP)
vpWidth = input.int(80, "Profile max width (bars)", minval=10, group=gVP)
vaPct   = input.float(70, "Value area %", minval=50, maxval=90, step=5, group=gVP) / 100.0
showCur = input.bool(true, "Current-day POC / VAH / VAL", group=gVP)
showPrev= input.bool(true, "Previous-day POC / VAH / VAL / H / L", group=gVP)
showNpoc= input.bool(true, "Naked POCs (untouched magnets)", group=gVP)
vpCol   = input.color(color.new(#5b9cf6, 55), "Profile histogram", group=gVP)
vaColr  = input.color(color.new(#5b9cf6, 25), "Value-area rows", group=gVP)

// ── DOM Liquidity Ladder (approximation)
gDom   = "⑧ DOM Liquidity Ladder (approx)"
showDom = input.bool(true, "Show DOM ladder", group=gDom, tooltip="No real order book on TradingView — this shows accumulated bid/ask volume-at-price near the current price as a liquidity proxy.")
domLvls = input.int(10, "Ladder levels (each side)", minval=3, maxval=25, group=gDom)

// ── Iceberg Orders (hidden refilling limit orders — approximation)
gIce   = "⑨ Iceberg Orders"
showIce = input.bool(true, "Detect icebergs", group=gIce, tooltip="Approximates hidden refilling limit orders: heavy one-sided aggression absorbed at a bar extreme while price is rejected from it. Real icebergs need a live tape (Sierra Chart).")
iceShare= input.float(0.45, "Min aggression share at extreme", minval=0.2, maxval=0.9, step=0.05, group=gIce, tooltip="Fraction of the bar's volume that must hit near the extreme.")
iceWick = input.float(0.5, "Min rejection wick (× bar range)", minval=0.1, maxval=0.9, step=0.05, group=gIce, tooltip="How far price must reject from the extreme (long wick = absorbed).")
iceBandR= input.int(2, "Extreme band (rows)", minval=1, maxval=6, group=gIce, tooltip="How many footprint rows near the high/low count as 'the extreme'.")
iceVolF = input.float(1.3, "Min bar volume (× avg)", minval=0.5, step=0.1, group=gIce)
iceHold = input.bool(true, "Keep iceberg level until broken", group=gIce)
iceCol  = input.color(color.new(#00bcd4, 0), "Iceberg color", group=gIce)

// ─────────────────────────────  HELPERS  ───────────────────────────────────
f_fmt(float v) =>
    a = math.abs(v)
    a >= 1e9 ? str.tostring(v/1e9, "#.##") + "B" :
     a >= 1e6 ? str.tostring(v/1e6, "#.##") + "M" :
     a >= 1e3 ? str.tostring(v/1e3, "#.#")  + "K" : str.tostring(v, "#")

fpTextSize = fpSize == "Tiny" ? size.tiny : fpSize == "Small" ? size.small : size.normal

// Auto LTF resolution from chart timeframe
chartSec = timeframe.in_seconds(timeframe.period)
autoRes  = chartSec >= 86400 ? "60" :
             chartSec >= 14400 ? "15" :
             chartSec >= 3600  ? "5"  :
             chartSec >= 900   ? "1"  :
             chartSec >= 180   ? "5S" : "1S"
ltfRes = autoLtf ? autoRes : manLtf

// ───────────────────  LOWER-TIMEFRAME VOLUME FEED  ─────────────────────────
[aO, aH, aL, aC, aV] = request.security_lower_tf(syminfo.tickerid, ltfRes,
     [open, high, low, close, volume])

// ─────────────────  PER-BAR DELTA (cheap pass, full history)  ───────────────
float atrRow = ta.atr(14)

// Footprint / iceberg row size: preset price step if set, else auto (ATR-bounded)
float rowSize = presetRow > 0 ? math.max(syminfo.mintick, presetRow) :
     math.max(syminfo.mintick, math.round((atrRow / rowsTgt) / syminfo.mintick) * syminfo.mintick)

f_classify(float o, float h, float l, float c, float v) =>
    float buy  = 0.0
    float sell = 0.0
    if clsMode == "Close vs Open"
        buy  := c >= o ? v : 0.0
        sell := c <  o ? v : 0.0
    else
        rng  = math.max(h - l, syminfo.mintick)
        frac = (c - l) / rng               // 0 = closed at low, 1 = closed at high
        buy  := v * frac
        sell := v * (1.0 - frac)
    [buy, sell]

// Compute POC / Value Area from a bin-volume array. Returns prices + POC bin index.
f_profile(array<float> tot, int minB, float bs, float vpct) =>
    int nb = array.size(tot)
    int pocJ = 0
    float pocV = -1.0
    float total = 0.0
    for j = 0 to nb - 1
        v = array.get(tot, j)
        total += v
        if v > pocV
            pocV := v
            pocJ := j
    float acc = pocV
    int up = pocJ
    int dn = pocJ
    float target = total * vpct
    while acc < target and (up < nb - 1 or dn > 0)
        vUp = up < nb - 1 ? array.get(tot, up + 1) : -1.0
        vDn = dn > 0      ? array.get(tot, dn - 1) : -1.0
        if vUp >= vDn
            up += 1
            acc += math.max(vUp, 0.0)
        else
            dn -= 1
            acc += math.max(vDn, 0.0)
    [(minB + pocJ) * bs, (minB + up) * bs, (minB + dn) * bs, minB + pocJ]

// Draw a horizontal level (ray + right-edge label) and register it for later cleanup.
f_lvlDraw(int x1, int x2, float pr, string tag, color cc, string style, array<line> lns, array<label> lbs) =>
    l = line.new(x1, pr, x2, pr, color=cc, width=1, style=style, extend=extend.right, force_overlay=true)
    lb = label.new(x2, pr, tag + " " + str.tostring(pr, format.mintick), style=label.style_label_left, color=color.new(cc, 20), textcolor=color.white, size=size.tiny, force_overlay=true)
    array.push(lns, l)
    array.push(lbs, lb)

int   n       = na(aC) ? 0 : array.size(aC)
float buySum  = 0.0
float sellSum = 0.0
float iceAskHi = 0.0   // buy aggression executed near the bar high (absorbed by a hidden offer)
float iceBidLo = 0.0   // sell aggression executed near the bar low  (absorbed by a hidden bid)
float iceBand  = iceBandR * rowSize

if n > 0
    for i = 0 to n - 1
        lo2 = array.get(aO,i)
        lh2 = array.get(aH,i)
        ll2 = array.get(aL,i)
        lc2 = array.get(aC,i)
        [b, s] = f_classify(lo2, lh2, ll2, lc2, array.get(aV,i))
        buySum  += b
        sellSum += s
        if lc2 >= high - iceBand
            iceAskHi += b
        if lc2 <= low + iceBand
            iceBidLo += s
else
    // Fallback: no LTF data → classify the chart bar itself
    [b, s] = f_classify(open, high, low, close, volume)
    buySum  := b
    sellSum := s

float barDelta = buySum - sellSum
float barVol   = buySum + sellSum
float avgVol   = ta.sma(barVol, 20)
float volRatio = avgVol > 0 ? barVol / avgVol : 0.0
float deltaPct = barVol > 0 ? math.abs(barDelta) / barVol : 0.0

// ── Iceberg detection (hidden refilling limit absorbed at a rejected extreme)
float barRng = math.max(high - low, syminfo.mintick)
bool iceSell = showIce and barVol > 0 and volRatio >= iceVolF and iceAskHi >= iceShare * barVol and (high - close) >= iceWick * barRng   // hidden offer  → resistance
bool iceBuy  = showIce and barVol > 0 and volRatio >= iceVolF and iceBidLo >= iceShare * barVol and (close - low)  >= iceWick * barRng   // hidden bid    → support

// ─────────────────────────────  CVD  ───────────────────────────────────────
bool newAnchor = cvdAnchor == "Session" ? (session.isfirstbar_regular) :
                 cvdAnchor == "Day"     ? timeframe.change("1D") :
                 cvdAnchor == "Week"    ? timeframe.change("1W") : false
var float cvd = 0.0
cvd := (newAnchor ? 0.0 : cvd) + barDelta
float cvdSig = ta.sma(cvd, cvdSmooth)

// ───────────────────────  DELTA-COLORED CANDLES  ───────────────────────────
float strength = math.min(deltaPct * math.max(volRatio, 0.5), 1.0)
color deltaColor = barDelta >= 0 ? color.new(buyCol, 80 - int(strength * 70)) : color.new(sellCol, 80 - int(strength * 70))
barcolor(colorBars ? deltaColor : na)

// ─────────────────────  ORDER-FLOW PATTERN DETECTORS  ──────────────────────
bool highVol = volRatio >= volFact
bool strongD = deltaPct >= dPct

// Absorption: heavy aggression, opposite delta, price refuses to follow
bool absBull = showAbs and highVol and strongD and barDelta < 0 and close >= open   // sellers absorbed
bool absBear = showAbs and highVol and strongD and barDelta > 0 and close <= open   // buyers absorbed

// Exhaustion: new extreme reached on shrinking volume (aggressor ran dry)
bool exhUp = showExh and high >= ta.highest(high, 10) and volRatio <= exhFact and close < high
bool exhDn = showExh and low  <= ta.lowest(low, 10)  and volRatio <= exhFact and close > low

// Trapped traders: aggressive burst at a fresh extreme, then reversal close
bool trapTop = showTrap and high > high[1] and barDelta > 0 and strongD and close < open   // trapped longs
bool trapBot = showTrap and low  < low[1]  and barDelta < 0 and strongD and close > open   // trapped shorts

// CVD / price divergence via pivots
float ph = ta.pivothigh(high, divLb, divLb)
float pl = ta.pivotlow(low,  divLb, divLb)
var float lastPH  = na
var float lastPHc = na
var float lastPL  = na
var float lastPLc = na
bool bearDiv = false
bool bullDiv = false
if showDiv and not na(ph)
    cAt = cvd[divLb]
    if not na(lastPH) and ph > lastPH and cAt < lastPHc
        bearDiv := true
    lastPH  := ph
    lastPHc := cAt
if showDiv and not na(pl)
    cAt = cvd[divLb]
    if not na(lastPL) and pl < lastPL and cAt > lastPLc
        bullDiv := true
    lastPL  := pl
    lastPLc := cAt

// ─────────────────  PER-PRICE FOOTPRINT  (recent bars only)  ────────────────
bool doFp = (showFp or showStack) and (last_bar_index - bar_index < fpBars) and n > 0

var array<label> fpLabels = array.new<label>()

if doFp
    mAsk = map.new<int, float>()   // aggressive buys at each level
    mBid = map.new<int, float>()   // aggressive sells at each level
    int loLvl = na
    int hiLvl = na

    for i = 0 to n - 1
        c = array.get(aC, i)
        [b, s] = f_classify(array.get(aO,i), array.get(aH,i), array.get(aL,i), c, array.get(aV,i))
        lvl = int(math.round(c / rowSize))
        mAsk.put(lvl, (mAsk.contains(lvl) ? mAsk.get(lvl) : 0.0) + b)
        mBid.put(lvl, (mBid.contains(lvl) ? mBid.get(lvl) : 0.0) + s)
        loLvl := na(loLvl) or lvl < loLvl ? lvl : loLvl
        hiLvl := na(hiLvl) or lvl > hiLvl ? lvl : hiLvl

    // Bar POC (max total volume level) + busiest single cell (heatmap scale)
    int   pocLvl  = loLvl
    float pocVol  = -1.0
    float maxCell = 1.0
    for lvl = loLvl to hiLvl
        av  = mAsk.contains(lvl) ? mAsk.get(lvl) : 0.0
        bv  = mBid.contains(lvl) ? mBid.get(lvl) : 0.0
        tot = av + bv
        if tot > pocVol
            pocVol := tot
            pocLvl := lvl
        maxCell := math.max(maxCell, math.max(av, bv))

    // Unfinished auction: extreme where BOTH sides traded (no zero print)
    bool unfHi = (mAsk.contains(hiLvl) ? mAsk.get(hiLvl) : 0.0) > 0 and (mBid.contains(hiLvl) ? mBid.get(hiLvl) : 0.0) > 0
    bool unfLo = (mAsk.contains(loLvl) ? mAsk.get(loLvl) : 0.0) > 0 and (mBid.contains(loLvl) ? mBid.get(loLvl) : 0.0) > 0

    // Render each level + detect diagonal imbalances / stacks
    int   buyStackStart = na
    int   sellStackStart = na
    for lvl = loLvl to hiLvl
        ask = mAsk.contains(lvl) ? mAsk.get(lvl) : 0.0
        bid = mBid.contains(lvl) ? mBid.get(lvl) : 0.0
        bidBelow = mBid.contains(lvl-1) ? mBid.get(lvl-1) : 0.0
        askAbove = mAsk.contains(lvl+1) ? mAsk.get(lvl+1) : 0.0
        bool buyImb  = bidBelow > 0 and ask  >= imbRatio * bidBelow
        bool sellImb = askAbove > 0 and bid  >= imbRatio * askAbove

        // Stacked-imbalance zone tracking (≥ stackN consecutive same-side imbalances)
        buyStackStart  := buyImb  ? (na(buyStackStart)  ? lvl : buyStackStart)  : na
        sellStackStart := sellImb ? (na(sellStackStart) ? lvl : sellStackStart) : na
        if showStack and buyImb and (lvl - buyStackStart + 1) == stackN
            box.new(bar_index, (lvl+1)*rowSize, bar_index + zoneExt, buyStackStart*rowSize,
                 border_color=color.new(buyCol,40), bgcolor=color.new(buyCol,88), extend=extend.none, force_overlay=true)
        if showStack and sellImb and (lvl - sellStackStart + 1) == stackN
            box.new(bar_index, (lvl+1)*rowSize, bar_index + zoneExt, sellStackStart*rowSize,
                 border_color=color.new(sellCol,40), bgcolor=color.new(sellCol,88), extend=extend.none, force_overlay=true)

        if showFp
            bool isPoc  = lvl == pocLvl
            float price = lvl * rowSize
            // BID cell — sell orders, box sits LEFT of the candle
            if bid > 0 or not fpHide0
                bTr = fpHeat ? 88 - int(math.min(58, bid / maxCell * 58)) : 50
                bBg = sellImb ? color.new(sellCol, 6) : isPoc ? color.new(pocCol, 55) : color.new(sellCol, bTr)
                array.push(fpLabels, label.new(bar_index, price, bid > 0 ? f_fmt(bid) : "·",
                     style=label.style_label_right, color=bBg,
                     textcolor=sellImb ? color.white : color.new(color.white, 8),
                     size=fpTextSize, force_overlay=true))
            // ASK cell — buy orders, box sits RIGHT of the candle
            if ask > 0 or not fpHide0
                aTr = fpHeat ? 88 - int(math.min(58, ask / maxCell * 58)) : 50
                aBg = buyImb ? color.new(buyCol, 6) : isPoc ? color.new(pocCol, 55) : color.new(buyCol, aTr)
                array.push(fpLabels, label.new(bar_index, price, ask > 0 ? f_fmt(ask) : "·",
                     style=label.style_label_left, color=aBg,
                     textcolor=buyImb ? color.white : color.new(color.white, 8),
                     size=fpTextSize, force_overlay=true))

    // Per-bar totals + unfinished-auction marks
    if showFp
        totCol = barDelta >= 0 ? buyCol : sellCol
        arrow  = barDelta >= 0 ? "▲" : "▼"
        lb2 = label.new(bar_index, loLvl * rowSize - rowSize,
             arrow + " Δ " + f_fmt(barDelta) + "\n∑ " + f_fmt(barVol) + "   ◉ " + str.tostring(pocLvl * rowSize, format.mintick),
             style=label.style_label_up, color=color.new(totCol, 15),
             textcolor=color.white, size=size.tiny, force_overlay=true)
        array.push(fpLabels, lb2)
        if unfHi
            array.push(fpLabels, label.new(bar_index, hiLvl*rowSize + rowSize, "⤒", style=label.style_none, textcolor=sellCol, size=size.small, force_overlay=true))
        if unfLo
            array.push(fpLabels, label.new(bar_index, loLvl*rowSize - rowSize*2, "⤓", style=label.style_none, textcolor=buyCol, size=size.small, force_overlay=true))

// Keep footprint label array bounded (Pine also recycles at max object counts)
if array.size(fpLabels) > 480
    label.delete(array.shift(fpLabels))

// ════════════  VOLUME PROFILE · KEY LEVELS (today / yesterday) · DOM  ═══════════
// Daily bin size from the previous day's range → bounded, instrument-agnostic rows
float dayRangeEst = request.security(syminfo.tickerid, "1D", high[1] - low[1], lookahead=barmerge.lookahead_on)
float pdHigh      = request.security(syminfo.tickerid, "1D", high[1], lookahead=barmerge.lookahead_on)
float pdLow       = request.security(syminfo.tickerid, "1D", low[1],  lookahead=barmerge.lookahead_on)
float binSize = presetBin > 0 ? math.max(syminfo.mintick, presetBin) :
     (na(dayRangeEst) or dayRangeEst <= 0) ?
     math.max(syminfo.mintick, math.round((atrRow * 3 / profRows) / syminfo.mintick) * syminfo.mintick) :
     math.max(syminfo.mintick, math.round((dayRangeEst / profRows) / syminfo.mintick) * syminfo.mintick)

// Session (day) volume-at-price accumulators
var map<int, float> dTot = map.new<int, float>()
var map<int, float> dAsk = map.new<int, float>()
var map<int, float> dBid = map.new<int, float>()
var int dMinB = na
var int dMaxB = na
var int curDayStart  = na
var int prevDayStart = na

// Fixed previous-day + developing current-day levels
var float pdPoc = na
var float pdVah = na
var float pdVal = na
var float pdHi  = na
var float pdLo  = na
var float cdPoc = na
var float cdVah = na
var float cdVal = na

// Drawing object registers
var array<box>   vpBoxes    = array.new<box>()
var array<line>  curLines   = array.new<line>()
var array<label> curLabs    = array.new<label>()
var array<line>  prevLines  = array.new<line>()
var array<label> prevLabs   = array.new<label>()
var array<line>  npocLines  = array.new<line>()
var array<float> npocPrices = array.new<float>()

bool newDay = timeframe.change("1D")

// ── Day rollover: snapshot completed day → previous-day levels, register nPOC, reset
if barstate.isconfirmed and newDay and dTot.size() > 0 and not na(dMinB)
    array<float> tot0 = array.new<float>()
    for b = dMinB to dMaxB
        array.push(tot0, dTot.contains(b) ? dTot.get(b) : 0.0)
    [p0, vh0, vl0, _pb0] = f_profile(tot0, dMinB, binSize, vaPct)
    pdPoc := p0
    pdVah := vh0
    pdVal := vl0
    pdHi  := pdHigh
    pdLo  := pdLow
    // Register the just-completed POC as a naked POC (magnet until traded through)
    if showNpoc
        ln = line.new(bar_index, p0, bar_index + 1, p0, color=color.new(pocCol, 20), style=line.style_dotted, width=1, extend=extend.right, force_overlay=true)
        array.push(npocLines, ln)
        array.push(npocPrices, p0)
        if array.size(npocPrices) > 8
            line.delete(array.shift(npocLines))
            array.shift(npocPrices)
    // Reset for the new day
    dTot.clear()
    dAsk.clear()
    dBid.clear()
    dMinB := na
    dMaxB := na
    prevDayStart := curDayStart
    curDayStart  := bar_index

if na(curDayStart)
    curDayStart := bar_index

// ── Accumulate confirmed-bar intrabar volume into the day profile
if barstate.isconfirmed and n > 0
    for i = 0 to n - 1
        c = array.get(aC, i)
        v = array.get(aV, i)
        [b, s] = f_classify(array.get(aO,i), array.get(aH,i), array.get(aL,i), c, v)
        bin = int(math.round(c / binSize))
        dTot.put(bin, (dTot.contains(bin) ? dTot.get(bin) : 0.0) + v)
        dAsk.put(bin, (dAsk.contains(bin) ? dAsk.get(bin) : 0.0) + b)
        dBid.put(bin, (dBid.contains(bin) ? dBid.get(bin) : 0.0) + s)
        dMinB := na(dMinB) or bin < dMinB ? bin : dMinB
        dMaxB := na(dMaxB) or bin > dMaxB ? bin : dMaxB

// ── Remove naked POCs once price trades through them
if barstate.isconfirmed and showNpoc and array.size(npocPrices) > 0
    int k = array.size(npocPrices) - 1
    while k >= 0
        p = array.get(npocPrices, k)
        if low <= p and p <= high
            line.delete(array.get(npocLines, k))
            array.remove(npocLines, k)
            array.remove(npocPrices, k)
        k -= 1

// ── Render developing profile + current-day levels on the last bar
if barstate.islast and not na(dMinB) and dTot.size() > 0
    array<float> tot = array.new<float>()
    for b = dMinB to dMaxB
        array.push(tot, dTot.contains(b) ? dTot.get(b) : 0.0)
    [pcur, vhcur, vlcur, _pb] = f_profile(tot, dMinB, binSize, vaPct)
    cdPoc := pcur
    cdVah := vhcur
    cdVal := vlcur
    float maxV = array.max(tot)
    int   rightX = bar_index + vpWidth + 4

    // Histogram
    for bx in vpBoxes
        box.delete(bx)
    vpBoxes.clear()
    if showVP and maxV > 0
        for b = dMinB to dMaxB
            v = dTot.contains(b) ? dTot.get(b) : 0.0
            if v > 0
                w = math.max(1, int(math.round(v / maxV * vpWidth)))
                price = b * binSize
                inVA = price >= vlcur and price <= vhcur
                isPoc = math.abs(price - pcur) < binSize / 2
                col = isPoc ? color.new(pocCol, 25) : inVA ? vaColr : vpCol
                bx = box.new(rightX - w, price + binSize, rightX, price, border_color=color.new(col, 90), bgcolor=col, force_overlay=true)
                array.push(vpBoxes, bx)

    // Current-day POC/VAH/VAL lines + labels
    for ln in curLines
        line.delete(ln)
    curLines.clear()
    for lb in curLabs
        label.delete(lb)
    curLabs.clear()
    if showCur
        x1 = na(curDayStart) ? bar_index - 20 : curDayStart
        f_lvlDraw(x1, bar_index + 2, pcur,  "POC", pocCol,                line.style_solid,  curLines, curLabs)
        f_lvlDraw(x1, bar_index + 2, vhcur, "VAH", color.new(#5b9cf6, 0), line.style_dashed, curLines, curLabs)
        f_lvlDraw(x1, bar_index + 2, vlcur, "VAL", color.new(#5b9cf6, 0), line.style_dashed, curLines, curLabs)

// ── (Re)draw previous-day levels each new day, projected across the current day
if barstate.isconfirmed and newDay and showPrev and not na(pdPoc)
    for ln in prevLines
        line.delete(ln)
    prevLines.clear()
    for lb in prevLabs
        label.delete(lb)
    prevLabs.clear()
    f_lvlDraw(bar_index, bar_index + 1, pdPoc, "PD POC", color.new(#ff9800, 0),  line.style_solid,  prevLines, prevLabs)
    f_lvlDraw(bar_index, bar_index + 1, pdVah, "PD VAH", color.new(#ff9800, 40), line.style_dotted, prevLines, prevLabs)
    f_lvlDraw(bar_index, bar_index + 1, pdVal, "PD VAL", color.new(#ff9800, 40), line.style_dotted, prevLines, prevLabs)
    f_lvlDraw(bar_index, bar_index + 1, pdHi,  "PDH",    color.new(color.gray, 0), line.style_dashed, prevLines, prevLabs)
    f_lvlDraw(bar_index, bar_index + 1, pdLo,  "PDL",    color.new(color.gray, 0), line.style_dashed, prevLines, prevLabs)

// ─────────────────  DOM LIQUIDITY LADDER (approximation)  ───────────────────
var table dt = table.new(position.middle_left, 3, 60, border_width=1, frame_color=color.new(color.gray, 60), frame_width=1)
if showDom and barstate.islast and not na(dMinB)
    int centerBin = int(math.round(close / binSize))
    int rows = domLvls * 2 + 1
    // scale bars to the max ask/bid visible in the ladder
    float maxLad = 0.0
    for idx = 0 to rows - 1
        b = centerBin + domLvls - idx
        av = dAsk.contains(b) ? dAsk.get(b) : 0.0
        bv = dBid.contains(b) ? dBid.get(b) : 0.0
        maxLad := math.max(maxLad, math.max(av, bv))
    table.cell(dt, 0, 0, "BID", text_color=sellCol, text_size=size.tiny, bgcolor=color.new(color.gray, 75))
    table.cell(dt, 1, 0, "PRICE (DOM≈)", text_color=color.white, text_size=size.tiny, bgcolor=color.new(color.gray, 75))
    table.cell(dt, 2, 0, "ASK", text_color=buyCol, text_size=size.tiny, bgcolor=color.new(color.gray, 75))
    for idx = 0 to rows - 1
        b = centerBin + domLvls - idx
        price = b * binSize
        av = dAsk.contains(b) ? dAsk.get(b) : 0.0
        bv = dBid.contains(b) ? dBid.get(b) : 0.0
        alen = maxLad > 0 ? int(math.round(av / maxLad * 8)) : 0
        blen = maxLad > 0 ? int(math.round(bv / maxLad * 8)) : 0
        bool isHere = b == centerBin
        bool isPocR = not na(cdPoc) and math.abs(price - cdPoc) < binSize / 2
        rowBg = isHere ? color.new(pocCol, 70) : isPocR ? color.new(#5b9cf6, 80) : na
        table.cell(dt, 0, idx + 1, blen > 0 ? str.repeat("█", blen) : "·", text_color=sellCol, text_size=size.tiny, text_halign=text.align_right, bgcolor=rowBg)
        table.cell(dt, 1, idx + 1, str.tostring(price, format.mintick), text_color=isHere ? pocCol : color.new(color.gray, 0), text_size=size.tiny, bgcolor=rowBg)
        table.cell(dt, 2, idx + 1, alen > 0 ? str.repeat("█", alen) : "·", text_color=buyCol, text_size=size.tiny, text_halign=text.align_left, bgcolor=rowBg)

// ─────────────────────────────  ICEBERGS  ──────────────────────────────────
var array<line>  iceLines   = array.new<line>()
var array<label> iceLabs    = array.new<label>()
var array<float> icePx      = array.new<float>()
var array<bool>  iceSellArr = array.new<bool>()

// Register a new iceberg at the rejected extreme (confirmed bars only)
if barstate.isconfirmed and iceSell
    ln = line.new(bar_index, high, bar_index + 1, high, color=iceCol, style=line.style_solid, width=2, extend=(iceHold ? extend.right : extend.none), force_overlay=true)
    lb = label.new(bar_index, high, "🧊 " + f_fmt(iceAskHi), style=label.style_label_down, color=color.new(iceCol, 15), textcolor=color.white, size=size.tiny, force_overlay=true)
    array.push(iceLines, ln)
    array.push(iceLabs, lb)
    array.push(icePx, high)
    array.push(iceSellArr, true)
if barstate.isconfirmed and iceBuy
    ln = line.new(bar_index, low, bar_index + 1, low, color=iceCol, style=line.style_solid, width=2, extend=(iceHold ? extend.right : extend.none), force_overlay=true)
    lb = label.new(bar_index, low, "🧊 " + f_fmt(iceBidLo), style=label.style_label_up, color=color.new(iceCol, 15), textcolor=color.white, size=size.tiny, force_overlay=true)
    array.push(iceLines, ln)
    array.push(iceLabs, lb)
    array.push(icePx, low)
    array.push(iceSellArr, false)

// Remove iceberg levels once price trades through them
if barstate.isconfirmed and iceHold and array.size(icePx) > 0
    kk = array.size(icePx) - 1
    while kk >= 0
        p = array.get(icePx, kk)
        broken = array.get(iceSellArr, kk) ? close > p : close < p
        if broken
            line.delete(array.get(iceLines, kk))
            label.delete(array.get(iceLabs, kk))
            array.remove(iceLines, kk)
            array.remove(iceLabs, kk)
            array.remove(icePx, kk)
            array.remove(iceSellArr, kk)
        kk -= 1

// Cap the number of iceberg levels kept
while array.size(iceLines) > 20
    line.delete(array.shift(iceLines))
    label.delete(array.shift(iceLabs))
    array.shift(icePx)
    array.shift(iceSellArr)

// ─────────────────────────────  PLOTS (pane)  ──────────────────────────────
cvdArea = plot(cvd, "CVD", color = cvd >= 0 ? buyCol : sellCol, linewidth=2)
plot(cvdSig, "CVD signal", color=color.new(pocCol, 20), linewidth=1)
plot(0, "Zero", color=color.new(color.gray, 50))
fill(cvdArea, plot(0, display=display.none), color = cvd >= 0 ? color.new(buyCol, 85) : color.new(sellCol, 85))

// ─────────────────────────  PATTERN MARKERS (price)  ────────────────────────
plotshape(absBull, "Absorption ↑", shape.triangleup,   location.belowbar, color.new(buyCol,0),  size=size.small, text="ABS", textcolor=buyCol,  force_overlay=true)
plotshape(absBear, "Absorption ↓", shape.triangledown, location.abovebar, color.new(sellCol,0), size=size.small, text="ABS", textcolor=sellCol, force_overlay=true)
plotshape(exhDn,   "Exhaustion ↓", shape.circle,       location.belowbar, color.new(pocCol,0),  size=size.tiny,  text="EXH", textcolor=pocCol,  force_overlay=true)
plotshape(exhUp,   "Exhaustion ↑", shape.circle,       location.abovebar, color.new(pocCol,0),  size=size.tiny,  text="EXH", textcolor=pocCol,  force_overlay=true)
plotshape(trapBot, "Trapped shorts", shape.labelup,    location.belowbar, color.new(buyCol,0),  size=size.tiny,  text="TRAP", textcolor=color.white, force_overlay=true)
plotshape(trapTop, "Trapped longs",  shape.labeldown,  location.abovebar, color.new(sellCol,0), size=size.tiny,  text="TRAP", textcolor=color.white, force_overlay=true)
// Divergence markers plotted at the pivot (divLb bars back)
plotshape(bullDiv, "Bull CVD div", shape.diamond, location.belowbar, color.new(buyCol,0),  size=size.tiny, offset=-divLb, text="DIV", textcolor=buyCol,  force_overlay=true)
plotshape(bearDiv, "Bear CVD div", shape.diamond, location.abovebar, color.new(sellCol,0), size=size.tiny, offset=-divLb, text="DIV", textcolor=sellCol, force_overlay=true)
plotshape(iceSell, "Iceberg offer", shape.square, location.abovebar, color.new(iceCol,0), size=size.tiny, text="🧊", textcolor=iceCol, force_overlay=true)
plotshape(iceBuy,  "Iceberg bid",   shape.square, location.belowbar, color.new(iceCol,0), size=size.tiny, text="🧊", textcolor=iceCol, force_overlay=true)

// ─────────────────────────────  INFO TABLE  ────────────────────────────────
var table t = table.new(position.top_right, 2, 8, border_width=1, frame_color=color.new(color.gray,50), frame_width=1)
f_row(table tb, int r, string k, string v, color vc) =>
    table.cell(tb, 0, r, k, text_color=color.new(color.gray,0), text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, r, v, text_color=vc, text_size=size.small, text_halign=text.align_right)

if showTbl and barstate.islast
    diag = iceSell ? "Iceberg offer ↓" : iceBuy ? "Iceberg bid ↑" :
           absBull ? "Absorption ↑" : absBear ? "Absorption ↓" :
           exhUp or exhDn ? "Exhaustion" : trapTop ? "Trapped longs" : trapBot ? "Trapped shorts" :
           bearDiv ? "Bearish CVD div" : bullDiv ? "Bullish CVD div" :
           barDelta >= 0 ? "Buyers in control" : "Sellers in control"
    buyPct = barVol > 0 ? buySum / barVol * 100 : 0.0
    table.cell(t, 0, 0, "ORDER FLOW", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.gray,70))
    table.cell(t, 1, 0, ltfRes + " engine", text_color=color.new(color.gray,0), text_size=size.small, bgcolor=color.new(color.gray,70))
    f_row(t, 1, "Delta",   f_fmt(barDelta), barDelta >= 0 ? buyCol : sellCol)
    f_row(t, 2, "CVD",     f_fmt(cvd),      cvd >= 0 ? buyCol : sellCol)
    f_row(t, 3, "Volume",  f_fmt(barVol),   color.new(color.gray,0))
    f_row(t, 4, "Buy / Sell", str.tostring(buyPct, "#") + "% / " + str.tostring(100-buyPct, "#") + "%", buyPct >= 50 ? buyCol : sellCol)
    f_row(t, 5, "Vol vs avg", str.tostring(volRatio, "#.0") + "×", volRatio >= volFact ? pocCol : color.new(color.gray,0))
    f_row(t, 6, "Row size", str.tostring(rowSize, format.mintick), color.new(color.gray,0))
    table.cell(t, 0, 7, "Read", text_color=color.new(color.gray,0), text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 7, diag, text_color = diag == "Buyers in control" ? buyCol : diag == "Sellers in control" ? sellCol : pocCol, text_size=size.small, text_halign=text.align_right)

// ─────────────────────────────  ALERTS  ────────────────────────────────────
alertcondition(absBull, "Bullish Absorption", "OF: sellers absorbed — bullish reversal fuel")
alertcondition(absBear, "Bearish Absorption", "OF: buyers absorbed — bearish reversal fuel")
alertcondition(exhUp or exhDn, "Exhaustion", "OF: exhaustion at extreme — trend running dry")
alertcondition(trapTop, "Trapped Longs", "OF: trapped longs at high")
alertcondition(trapBot, "Trapped Shorts", "OF: trapped shorts at low")
alertcondition(bearDiv, "Bearish CVD Divergence", "OF: price HH, CVD LH — bearish divergence")
alertcondition(bullDiv, "Bullish CVD Divergence", "OF: price LL, CVD HL — bullish divergence")
alertcondition(iceSell, "Iceberg Offer", "OF: iceberg offer — hidden seller absorbing at the highs")
alertcondition(iceBuy,  "Iceberg Bid",   "OF: iceberg bid — hidden buyer absorbing at the lows")
