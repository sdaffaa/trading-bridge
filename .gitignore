.env

# نواتج بناء الريلز (تُرسل للمستخدم ولا تُرفع للريبو)
.claude/skills/*/scripts/*.mp4
.claude/skills/*/scripts/*.wav
.claude/skills/*/scripts/qa*.png

# مخرجات التعليق الصوتي (تُرسل ولا تُرفع)
.claude/skills/*/scripts/vo/

# صور الجارت الأصلي (تُرسل ولا تُرفع)
.claude/skills/*/scripts/chart_orig_*.png

# تشغيلة ٥٥: ما يُعاد توليده بأمر واحد لا يُرفع.
# الـHTML وحده ٢٫٥ م.ب لأن الخطوط مضمَّنة base64، وصور الرندر بضعف الدقّة
# وسيطة، والـZIP تجميعةُ ما هو مرفوع أصلاً. المرفوع: الثلاثون صفحة النهائية
# والـPDF والREADME وورقة التواصل — وهي المخرَج الذي يُنشر.
.claude/skills/*/scripts/out55/*.html
.claude/skills/*/scripts/out55/png/
.claude/skills/*/scripts/out55/final/*.zip
.claude/skills/*/scripts/out55/contact_sheet.png

# تشغيلة ٥٦: الإطارات ونواتج الرندر الوسيطة تُعاد بأمر واحد.
.claude/skills/*/scripts/frames56/
.claude/skills/*/scripts/out56/frames*/
.claude/skills/*/scripts/out56/qa*/
.claude/skills/*/scripts/out56/dec/
.claude/skills/*/scripts/out56/guide_png/
.claude/skills/*/scripts/out56/*.html
.claude/skills/*/scripts/out56/reel56_raw.mp4
.claude/skills/*/scripts/out56/*sheet*.png
.claude/skills/*/scripts/out56/f1*.png

# تشغيلة ٥٧: الإطارات ونواتج الرندر الوسيطة تُعاد بأمر واحد.
.claude/skills/*/scripts/frames57/
.claude/skills/*/scripts/out57/qa*/
.claude/skills/*/scripts/out57/dec/
.claude/skills/*/scripts/out57/*.html
.claude/skills/*/scripts/out57/*.log
.claude/skills/*/scripts/out57/g1*.png

# تشغيلة ٥٨: المرفوع هو المخرَج الذي يُنشر — صفحات الكاروسيل ١٠٨٠×١٣٥٠
# والأدلة PDF. أما رندر ضعف الدقّة وصفحات الدليل المفردة (هي نفسها داخل
# الـPDF) والـZIP (تجميعةُ ما هو مرفوع) فتُعاد بأمر واحد ولا تُرفع.
.claude/skills/*/scripts/out58/car_*/[0-9][0-9].png
.claude/skills/*/scripts/out58/guide_*/
.claude/skills/*/scripts/out58/*.zip
