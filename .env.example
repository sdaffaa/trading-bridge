# Required. Shared secret the TradingView alert must present, either as the
# X-Webhook-Secret header or a "secret" field in the JSON body. /webhook
# returns 503 until this is set.
WEBHOOK_SECRET=change-me

# Optional. Where the formatted setup is delivered.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Adds a short Claude comment underneath the setup. Defaults to on
# when ANTHROPIC_API_KEY is present; set to 0 to keep alerts fully deterministic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ENABLE_LLM_COMMENTARY=1

# Optional. Defaults to 5000.
PORT=5000
