# مفتاح Claude API — عند توفّره يعمل الوكلاء بوضع الذكاء الاصطناعي.
# بدونه يعمل النظام بالكامل بالوضع الاحتياطي الكمّي.
ANTHROPIC_API_KEY=

# نموذج Claude المستخدم (اختياري)
