# trading-bridge configuration — copy to .env and fill in. NEVER commit real secrets.

# --- credentials ---
ANTHROPIC_API_KEY=            # or use `ant auth login` and leave blank
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- webhook ---
# TradingView only allows HTTP on port 80 (or HTTPS on 443). Use PORT=80 so the
# webhook URL is http://<ip>/webhook (no port). Any port works for local testing.
PORT=5000
HOST=0.0.0.0
WEBHOOK_SECRET=              # optional; if set, sender must pass X-Webhook-Secret or ?secret=

# --- safety (defaults are safe) ---
AGENT_DRY_RUN=1             # 1 = simulate act tools (no real Telegram send). Set 0 to go live.
AGENT_KILL_FILE=/tmp/agent.kill   # create this file to halt all acting instantly

# --- model / reasoning ---
AGENT_MODEL=claude-opus-4-8
AGENT_MAX_TOKENS=8000

# --- policy ---
AGENT_ALLOWED_SYMBOLS=OANDA:XAUUSD,BINANCE:BTCUSDT,FX:EURUSD
AGENT_ALLOWED_ACTIONS=buy,sell,info

# --- run limits ---
AGENT_MAX_ITERS=8
AGENT_TIMEOUT_S=90

# --- persistence (idempotency across restarts) ---
AGENT_STATE_DIR=/tmp/agent-state

# --- optional: precise chart reads via the tradingview-browse-select skill ---
# Needs a browser + TradingView login; leave 0 unless configured.
AGENT_ENABLE_CHART_READS=0

# --- autonomous scheduler: the system starts analyzing on its own (no webhook) ---
# 0 = off (react to webhooks only). >0 = analyze every N seconds.
AGENT_SCHEDULE_SECONDS=0
AGENT_SCHEDULE_SYMBOLS=       # empty = first allowed symbol; or "OANDA:XAUUSD,FX:EURUSD"
AGENT_SCHEDULE_TIMEFRAME=240

# --- live market data (so scheduled analysis uses real prices, no browser) ---
AGENT_DATA_PROVIDER=none      # none | fmp | generic
AGENT_DATA_API_KEY=           # for fmp
AGENT_DATA_URL_TEMPLATE=      # generic: https://api.example.com/quote/{symbol}
AGENT_DATA_PRICE_PATH=price   # generic: dot-path to the price in the JSON (e.g. data.0.p)

# --- market-hours awareness (skip scheduled runs when the market is closed) ---
AGENT_RESPECT_MARKET_HOURS=1

# --- cost / rate controls (0 = off) ---
AGENT_DAILY_TOKEN_BUDGET=0    # cap tokens/day across all runs
AGENT_MIN_RUN_INTERVAL_S=0    # throttle: min seconds between runs

# --- self-monitoring / failure alerting (operator alerts ignore dry-run) ---
AGENT_ALERT_ON_FAILURE=1
AGENT_ALERT_FAILS_THRESHOLD=3
AGENT_HEARTBEAT_MAX_SILENCE_S=0   # >0 = alert if no successful run within N seconds

# --- VISION mode: agents OPEN the chart, screenshot it, and mark it up (per school) ---
# Needs Chromium (built into the image) and a 2GB+ host. Trigger via the scheduler.
AGENT_VISION_MODE=0                 # 1 = visual multi-agent markup pipeline
AGENT_VISION_SCHOOLS=ict,smc,volume_profile,footprint
AGENT_SHOT_WAIT_MS=10000            # ms to wait for the chart canvas to render
# to run it on a schedule (e.g. every 4h), also set:
#   AGENT_SCHEDULE_SECONDS=14400
#   AGENT_SCHEDULE_SYMBOLS=OANDA:XAUUSD
#   AGENT_SCHEDULE_TIMEFRAME=240

# --- risk management (the agent defines entry / stop / targets + size) ---
AGENT_ACCOUNT_BALANCE=0            # your balance (for $ risk + position size); 0 = unknown
AGENT_RISK_PERCENT=1.0            # % risked per trade
AGENT_MIN_RR=2.0                 # minimum reward:risk to take a trade

# --- optional execution layer (place orders) — OFF by default, deliberately ---
AGENT_ENABLE_EXECUTION=0
AGENT_BROKER=paper           # paper = record only (no real money)
AGENT_MAX_POSITION_SIZE=0.01
AGENT_MAX_OPEN_POSITIONS=1
AGENT_MIN_CONFIDENCE_TO_TRADE=0.7
